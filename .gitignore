# ==============================================================================
# GodHand Studio & Mod Repository — Unified .gitignore
# ==============================================================================

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb

# Build Outputs & Bundles
dist/
build/
out/
.vite/
*.tsbuildinfo

# Gradle Builds & Cache
.gradle/
godhand/.gradle/
godhand/build/
!godhand/build/libs/Libs Main_jar/*.jar
jules_gradle_env/
original_gradle_files/
gradle-app.setting

# Minecraft Server Runtime Data (Generated by Gradle run tasks)
run/
godhand/run/
*.dat
*.dat_old
*.mca

# Local Runtime JDKs & Minecraft Mappings (Large local binaries)
jdk_runtime/
jdk21_working/
yarn
godhand/mappings/
*.tiny

# Documentation Archives & Temporary Artifacts
docs/archive/
*.zip
*.tar.gz

# Code Intelligence & Analyzer Caches
.codegraph/*
!.codegraph/.gitignore
.fallow/
.agents/
*.bin
fallow-report.md
vibeworks-check.json

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.nb-gradle/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Archives & Temporary Test Artifacts
*.zip
*.tar.gz
*.bundle
export-godhand.bundle
test_results.txt
godhand/test_results.txt
.firebase/
find_locks.py
.aistudio/
